# Cloudflare Workers AI：默认后端，用于跨来源语义去重、中文摘要、分类和重要性排序
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8

# OpenAI：可选的付费备用后端；仅在两项 Cloudflare 凭证均未配置，且显式设置 OPENAI_API_KEY 时使用
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# 飞书“AI 增长内部群”中的 V2 自定义机器人
FEISHU_WEBHOOK_URL=
# 如果机器人启用了“签名校验”，填写对应密钥；否则留空
FEISHU_SIGNING_SECRET=

# 本地运行时可选；GitHub Actions 会自动提供 GITHUB_TOKEN
GITHUB_TOKEN=

TARGET_NEWS_COUNT=10
LOOKBACK_HOURS=36
# 近 36 小时不足 10 条时，自动回看最近 7 天补足；旧闻仍显示真实发布日期
FALLBACK_LOOKBACK_HOURS=168
MAX_CANDIDATES=80
STATE_PATH=.state/history.json
